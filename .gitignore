# --- Python ---
__pycache__/
*.py[cod]
.venv/
.venv
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# --- OS ---
.DS_Store

# --- Cloned reference code (kept local, not committed to your repo) ---
reference/SGCN/
reference/BrainNetworkTransformer/

# =============================================================================
# DATA IS NOT COMMITTED.
# ADNI Data Use Agreement forbids redistributing subject data. Keep all raw
# scans, NIfTI files, and derived subject-level data OUT of version control.
# =============================================================================
data/raw/**
data/nifti/**
data/timeseries/**
data/connectivity/**
data/metadata/**
data/pq_embeddings/**
data/pq_subject_fit/**
data/*.csv

# Keep the empty-folder placeholders so the structure is preserved
!**/.gitkeep

# --- Model checkpoints & large outputs (regenerable) ---
outputs/models/*.pt
outputs/models/*.pth
outputs/models/*.joblib

# QC overlays render subject brain images (derived ADNI data) - keep local
outputs/figures/atlas_qc/**
outputs/experiments_section.docx
